# Kopieren nach .env (Backend, nie committen — .gitignore) bzw.
# frontend/.env (Vite-Client). Siehe Supabase-Dashboard → Project Settings → API.

# Backend: Port + SQLite-Datei
PORT=1337
# DB_PATH=./data/app.db

# Backend: Produkt-Crawl per URL in zwei Stufen (POST /api/import-link,
# Interface in src/web/backend/crawl-providers.js):
# Stufe 1 — Inhalt parsen (Parse-Tool): Fetcher via CRAWL_FETCH_PROVIDER
# (Default "direct", eingebaut ohne Konfiguration), "headless" (Puppeteer,
# rendert JavaScript — für JS-Seiten und Bot-Schutz wie Tesla) oder "local-cmd"
# (externes Parse-Tool auf dieser Maschine, z.B. Skript in tmux-Session).
# Übersteuerbar pro Request mit { "fetcher": "direct|headless|local-cmd" }.
# Fällt direct fehl oder liefert weniger als CRAWL_DIRECT_MIN_CHARS Zeichen,
# wird automatisch headless nachgeladen (sofern Puppeteer installiert ist).
# CRAWL_FETCH_PROVIDER=direct
# Schwellwert für den Headless-Fallback (Default 1000):
# CRAWL_DIRECT_MIN_CHARS=1000
# Timeout für den Headless-Browser in ms (Default 60000):
# CRAWL_HEADLESS_TIMEOUT_MS=60000
# {url}/{journey} werden ersetzt, zusätzlich als Env CRAWL_URL/CRAWL_JOURNEY;
# stdout ist { "title"?, "text" } als JSON (oder reiner Text als Fallback).
# CRAWL_FETCH_CMD=./scripts/parse.sh {url} {journey}
# Stufe 2 — Inhalt mit LLM auswerten: Extraktor via CRAWL_EXTRACT_PROVIDER
# oder pro Request mit { "provider": "agy|n8n|remote-ai|local-cmd" }.
# Default "agy" (wenn das Binary im PATH steht), sonst "n8n".
# Statusliste beider Stufen via GET /api/crawl-providers.
# CRAWL_EXTRACT_PROVIDER=agy
# agy-CLI (Print-Mode ohne Tools, Antwort via JSON-Schema erzwungen):
# CRAWL_AGY_BIN=agy
# CRAWL_AGY_MODEL=
# CRAWL_AGY_EFFORT=low
# CRAWL_AGY_TIMEOUT_MS=120000
# n8n-Webhook (Fallback-Extraktor ohne agy-Binary, crawlt selbst wie bisher):
# N8N_WEBHOOK_URL=
# Remote-LLM per HTTP-JSON (POST { url, journey, title, text }, Key optional
# als Bearer; Antwort: Produkt-JSON mit mind. { "name" }):
# CRAWL_REMOTE_URL=
# CRAWL_REMOTE_KEY=
# Lokale LLM-Auswertung (Inhalt als JSON über stdin, Env wie oben plus
# CRAWL_TITLE; stdout: Produkt-JSON mit mind. { "name" }):
# CRAWL_EXTRACT_CMD=./scripts/extract.sh
# Journey-Benennung (POST /api/suggest-journey, MCP journey.create_from_link ohne Slug)
# nutzt denselben Extraktor + src/agent/prompts/journey_naming_prompt.md
# (naming-fähig: agy, remote-ai, local-cmd).
# Max. Zeichen des geparsten Inhalts an die LLM (Default 20000):
# CRAWL_MAX_CHARS=20000

# Backend: Supabase-Auth (User-Layer, Phase 1: verify-only)
# Projekt-URL aus den OAuth-/OIDC-Endpoints:
SUPABASE_URL=https://epknwdxauctkdcwpsslh.supabase.co
# Publishable/anon key aus dem Dashboard (API Keys). Auch als
# SUPABASE_PUBLISHABLE_KEY lesbar (neues sb_publishable_-Format).
SUPABASE_ANON_KEY=
# Alle /api-Daten-Routen verlangen immer eine Identität (401 ohne gültigen
# Bearer-Token): entweder einen langlebigen API-Key (ein Key = ein User,
# siehe "node src/agent/scripts/create-api-key.js --user <id>") oder ein
# Supabase-JWT (Browser-Login). Jede Identität sieht nur ihre eigenen
# Journeys (Owner-Trennung per owner_id). AUTH_REQUIRED=true schaltet
# zusätzlich das strikte Supabase-Gate scharf (für Setups ohne API-Keys).
# AUTH_REQUIRED=true

# Frontend (frontend/.env): gleiche Werte mit VITE_-Prefix
# VITE_SUPABASE_URL=https://epknwdxauctkdcwpsslh.supabase.co
# VITE_SUPABASE_ANON_KEY=

# OAuth-Anbieter (Google/Apple) — einmalig im Supabase-Dashboard einrichten
# (keine Env-Variablen nötig, das Backend verifiziert alle Supabase-JWTs gleich):
# 1. Authentication → Providers → Google bzw. Apple aktivieren:
#    - Google: Client ID + Client Secret aus der Google Cloud Console
#      (APIs & Services → Credentials → OAuth-Client-ID; Authorized redirect URI:
#      https://epknwdxauctkdcwpsslh.supabase.co/auth/v1/callback).
#    - Apple: Services ID + Team ID + Key ID + Private Key (.p8) aus dem
#      Apple Developer Portal (dort als Return URL dieselbe Callback-URL
#      wie bei Google hinterlegen).
# 2. Authentication → URL Configuration:
#    - Site URL = Produktions-Origin der App.
#    - Additional Redirect URLs: http://localhost:5173/login (Dev) plus
#      <Produktions-Origin>/login — die App springt nach dem OAuth-Flow
#      auf /login zurück (sonst verweigert Supabase den Redirect).
